#!/usr/bin/env bash
set -euo pipefail

# Linux Gamer Life openSUSE Bootstrap (TTY friendly)
# Goal: Start from openSUSE minimal server (TTY), run once, reboot into KDE Plasma.
#
# Installs and configures:
# - KDE Plasma + SDDM
# - Packman repo + vendor switch for full codecs (FFmpeg and friends)
# - Core tools: curl, wget, git, fastfetch, btop, htop, python3, pip
# - Flatpak + Flathub + Flatseal + common apps
# - Distrobox
# - Multimedia stack + AMD bits (Mesa, Vulkan, VA-API, GStreamer)
# - Gaming: Steam, Lutris, MangoHud, OBS Studio (with Flatpak fallbacks where sensible)
# - Virtualization: virt-manager + libvirt/KVM stack
#
# Notes:
# - This script tries to work on both openSUSE Tumbleweed and Leap.
# - If a package name differs on your release, the script will warn and continue.

# -----------------------------
# Colours (LGL style)
# -----------------------------
GREEN='\033[38;2;0;255;0m'
ORANGE='\033[38;2;255;153;0m'
RED='\033[38;2;255;68;68m'
WHITE='\033[38;2;249;249;249m'
RESET='\033[0m'
BOLD='\033[1m'

section() { printf "\n${BOLD}${GREEN}==> %s${RESET}\n" "$1"; }
info() { printf "${WHITE}%s${RESET}\n" "$1"; }
warn() { printf "${BOLD}${RED}Warning:${RESET} ${WHITE}%s${RESET}\n" "$1"; }
cmdhint() { printf "${ORANGE}%s${RESET}\n" "$1"; }

require_root() {
  if [[ ${EUID} -ne 0 ]]; then
    warn "Run with sudo:"
    cmdhint "sudo bash $0"
    exit 1
  fi
}

get_target_user() {
  if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
    printf "%s" "${SUDO_USER}"
  else
    printf "%s" "$(logname 2>/dev/null || echo root)"
  fi
}

have_cmd() { command -v "$1" >/dev/null 2>&1; }

zypper_refresh() {
  zypper -n --gpg-auto-import-keys refresh
}

try_install() {
  # Install packages one-by-one so a missing package does not kill the whole script.
  local pkg
  for pkg in "$@"; do
    if zypper -n in -y "$pkg" >/dev/null 2>&1; then
      info "Installed: $pkg"
    else
      warn "Could not install: $pkg (skipping)"
    fi
  done
}

repo_exists() {
  local alias="$1"
  zypper lr -u | awk '{print $1}' | grep -qx "$alias"
}

add_repo_if_missing() {
  local alias="$1"
  local name="$2"
  local url="$3"
  local priority="${4:-99}"

  if repo_exists "$alias"; then
    info "Repo exists: $alias"
    return 0
  fi

  info "Adding repo: $name"
  zypper -n ar -f -p "$priority" -n "$name" "$url" "$alias" >/dev/null 2>&1 || {
    warn "Failed to add repo: $alias"
    return 1
  }
}

detect_opensuse() {
  if [[ ! -r /etc/os-release ]]; then
    warn "Cannot read /etc/os-release"
    exit 1
  fi

  # shellcheck disable=SC1091
  source /etc/os-release

  OS_ID="${ID:-}"
  OS_VERSION_ID="${VERSION_ID:-}"

  if [[ "$OS_ID" != "opensuse-tumbleweed" && "$OS_ID" != "opensuse-leap" && "$OS_ID" != "opensuse" ]]; then
    warn "This does not look like openSUSE. ID=${OS_ID}"
    exit 1
  fi

  info "Detected: ${PRETTY_NAME:-openSUSE} (ID=${OS_ID}, VERSION_ID=${OS_VERSION_ID})"
}

setup_official_repos() {
  # Many minimal installs already have repos. This only adds missing common repos.
  # URLs below follow the official openSUSE structure.

  if [[ "$OS_ID" == "opensuse-tumbleweed" ]]; then
    add_repo_if_missing "repo-oss" "openSUSE-Tumbleweed-Oss" "https://download.opensuse.org/tumbleweed/repo/oss/" 99 || true
    add_repo_if_missing "repo-non-oss" "openSUSE-Tumbleweed-Non-Oss" "https://download.opensuse.org/tumbleweed/repo/non-oss/" 99 || true
    add_repo_if_missing "repo-update" "openSUSE-Tumbleweed-Update" "https://download.opensuse.org/update/tumbleweed/" 99 || true
    add_repo_if_missing "repo-update-non-oss" "openSUSE-Tumbleweed-Update-Non-Oss" "https://download.opensuse.org/update/tumbleweed-non-oss/" 99 || true
  else
    # Leap
    if [[ -z "$OS_VERSION_ID" ]]; then
      warn "VERSION_ID is empty, cannot build Leap repo URLs"
      return 0
    fi
    add_repo_if_missing "repo-oss" "openSUSE-Leap-Oss" "https://download.opensuse.org/distribution/leap/${OS_VERSION_ID}/repo/oss/" 99 || true
    add_repo_if_missing "repo-non-oss" "openSUSE-Leap-Non-Oss" "https://download.opensuse.org/distribution/leap/${OS_VERSION_ID}/repo/non-oss/" 99 || true
    add_repo_if_missing "repo-update" "openSUSE-Leap-Update" "https://download.opensuse.org/update/leap/${OS_VERSION_ID}/oss/" 99 || true
    add_repo_if_missing "repo-update-non-oss" "openSUSE-Leap-Update-Non-Oss" "https://download.opensuse.org/update/leap/${OS_VERSION_ID}/non-oss/" 99 || true
  fi

  zypper_refresh
}

setup_packman() {
  section "Add Packman and switch codecs to Packman"

  local packman_url=""
  if [[ "$OS_ID" == "opensuse-tumbleweed" ]]; then
    packman_url="https://ftp.gwdg.de/pub/linux/misc/packman/suse/openSUSE_Tumbleweed/"
  else
    if [[ -z "$OS_VERSION_ID" ]]; then
      warn "VERSION_ID is empty, skipping Packman setup"
      return 0
    fi
    packman_url="https://ftp.gwdg.de/pub/linux/misc/packman/suse/openSUSE_Leap_${OS_VERSION_ID}/"
  fi

  add_repo_if_missing "packman" "Packman Repository" "$packman_url" 90 || true
  zypper_refresh

  # Vendor switch is the standard way to get full multimedia support from Packman.
  # On Tumbleweed this is commonly done with dup.
  if [[ "$OS_ID" == "opensuse-tumbleweed" ]]; then
    if zypper -n dup --from packman --allow-vendor-change >/dev/null 2>&1; then
      info "Packman vendor switch complete"
    else
      warn "Packman vendor switch failed (continuing)"
    fi
  else
    # Leap: safer to just allow vendor change during install of the key multimedia packages.
    info "Leap detected: will prefer Packman when installing multimedia packages"
  fi
}

printf "${BOLD}${GREEN}Linux Gamer Life openSUSE KDE Bootstrap${RESET}\n"
require_root

TARGET_USER="$(get_target_user)"
info "Target user: ${TARGET_USER}"

detect_opensuse

# -----------------------------
# 1) Base update and core tools
# -----------------------------
section "Base update and core tools"

setup_official_repos

# Update system
if [[ "$OS_ID" == "opensuse-tumbleweed" ]]; then
  zypper -n dup || true
else
  zypper -n up || true
fi

try_install \
  curl wget git \
  fastfetch btop htop \
  python3 python3-pip \
  flatpak \
  distrobox \
  vlc

# -----------------------------
# 2) Packman codecs
# -----------------------------
setup_packman

# Key multimedia packages with Packman preference
# (Names can vary slightly by release, so we install what we can.)
if [[ "$OS_ID" == "opensuse-leap" ]]; then
  # Allow vendor change on Leap when pulling in multimedia bits
  zypper -n in -y --allow-vendor-change ffmpeg || warn "Could not install ffmpeg (skipping)"
else
  try_install ffmpeg
fi

try_install \
  gstreamer \
  gstreamer-plugins-base \
  gstreamer-plugins-good \
  gstreamer-plugins-bad \
  gstreamer-plugins-ugly \
  gstreamer-plugins-libav

# -----------------------------
# 3) KDE Plasma (minimal-ish)
# -----------------------------
section "KDE Plasma and SDDM"

# Pattern is the most reliable way on openSUSE, but it can be larger than Arch minimal.
# We attempt the pattern first, then fall back to individual packages if needed.
if zypper -n in -t pattern -y kde_plasma >/dev/null 2>&1; then
  info "Installed pattern: kde_plasma"
else
  warn "Pattern kde_plasma not available, installing core KDE packages instead"
  try_install \
    sddm \
    plasma5-session plasma5-desktop \
    konsole spectacle ark okular gwenview \
    discover discover6
fi

# -----------------------------
# 4) Multimedia and AMD stack
# -----------------------------
section "Multimedia and AMD drivers"

try_install \
  Mesa Mesa-dri \
  Mesa-vulkan-radeon \
  libvulkan1 vulkan-tools \
  libva libva-utils \
  libva-mesa-driver

# -----------------------------
# 5) Gaming tools
# -----------------------------
section "Gaming tools"

# Steam often needs non-oss enabled (handled earlier). Install what we can.
try_install steam lutris mangohud obs-studio

# -----------------------------
# 6) Flatpak apps
# -----------------------------
section "Flatpak apps"

# Ensure Flatpak service bits exist
if ! have_cmd flatpak; then
  warn "flatpak command not found even after install attempt (skipping Flatpak section)"
else
  flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo || true

  # Apps matching your Arch script intent
  flatpak install -y flathub com.github.tchx84.Flatseal || true
  flatpak install -y flathub net.davidotek.pupgui2 || true
  flatpak install -y flathub com.vysp3r.ProtonPlus || true
  flatpak install -y flathub com.heroicgameslauncher.hgl || true
  flatpak install -y flathub org.libreoffice.LibreOffice || true

  # Useful fallbacks if RPM packages were missing
  flatpak install -y flathub net.lutris.Lutris || true
  flatpak install -y flathub com.obsproject.Studio || true
fi

# -----------------------------
# 7) Virtualization
# -----------------------------
section "Virtualization"

try_install \
  virt-manager \
  qemu qemu-kvm \
  libvirt libvirt-client \
  virt-install virt-viewer \
  ovmf swtpm

# Enable libvirt
systemctl enable --now libvirtd || true

# Add user to groups (names can differ slightly, so we try both common ones)
usermod -aG libvirt "${TARGET_USER}" 2>/dev/null || true
usermod -aG kvm "${TARGET_USER}" 2>/dev/null || true

# -----------------------------
# 8) Boot target and display manager
# -----------------------------
section "Boot configuration"

systemctl set-default graphical.target || true
systemctl enable sddm || true

# -----------------------------
# Finish
# -----------------------------
section "Complete"

info "Bootstrap finished"
info "Reboot to start KDE Plasma:"
cmdhint "reboot"
